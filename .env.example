# ==============================================================================
# AI Codebase Architect - Environment Configuration (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google OAuth 2.0 Credentials
# (From Google Cloud Console -> Credentials -> OAuth 2.0 Client IDs -> Web Application)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ------------------------------------------------------------------------------
# 2. GitHub OAuth 2.0 Credentials
# (From GitHub -> Settings -> Developer Settings -> OAuth Apps)
# ------------------------------------------------------------------------------
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# ------------------------------------------------------------------------------
# 3. LLM API Keys (Server Defaults / Fallbacks)
# Note: Users can also use "Bring Your Own Key (BYOK)" directly in the web UI!
# ------------------------------------------------------------------------------
GEMINI_API_KEY= 
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# ------------------------------------------------------------------------------
# 4. Local Ollama LLM (Optional)
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL=http://host.docker.internal:11434

# ------------------------------------------------------------------------------
# 5. Database & Infrastructure Ports (Defaults)
# ------------------------------------------------------------------------------
POSTGRES_DB=aicodebase
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# 6. Service Ports & Public URLs
# ------------------------------------------------------------------------------
BACKEND_PORT=8080
AI_SERVICE_PORT=8001
FRONTEND_PORT=3000
FRONTEND_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 7. JWT Security
# ------------------------------------------------------------------------------
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# ------------------------------------------------------------------------------
# 8. SMTP Email Server (Optional - for sending real emails)
# If not configured, verification links are safely printed to backend Docker logs!
# ------------------------------------------------------------------------------
SPRING_MAIL_HOST=smtp.resend.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=resend
SPRING_MAIL_PASSWORD=your_resend_api_key_here
SPRING_MAIL_FROM=onboarding@resend.dev
